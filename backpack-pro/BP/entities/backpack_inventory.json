{
	"format_version": "1.17.11",
	"minecraft:entity": {
		"description": {
			"identifier": "backpack:entity_container", 
		//	"runtime_identifier":"minecraft:wither_skull_dangerous",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"bp:is_dyes": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bps:color_r": {
					"client_sync": true,
					"type": "int",
					"range": [ -20, 20 ],
					"default": 0
				},
				"bps:color_g": {
					"client_sync": true,
					"type": "int",
					"range": [ -20, 20 ],
					"default": 0
				},
				"bps:color_b": {
					"client_sync": true,
					"type": "int",
					"range": [ -20, 20 ],
					"default": 0
				},

				"bp:is_backpack": {
					"client_sync": true,
					"type": "int",
					"range": [ 0, 6 ],
					"default": 0
				},
				"bps:is_skin": {
					"client_sync": true,
					"type": "int",
					"range": [ 0, 13 ],
					"default": 0
				},

				"bp:farm": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bp:furn": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bp:torch": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bp:pick": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bp:jukebox": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bp:liquid": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"bp:espada": {
					"type": "bool",
					"client_sync": true,
					"default": false
				}
			}
		},
		"component_groups": {
			"leather": {
				"minecraft:inventory": {
					"container_type": "minecart_chest",
				    "can_be_siphoned_from": true,
					"inventory_size": 50
				}
			},
			"copper": {
				"minecraft:inventory": {
					"container_type": "minecart_chest",
				    "can_be_siphoned_from": true,
					"inventory_size": 59
				}
			},
			"iron": {
				"minecraft:inventory": {
					"container_type": "minecart_chest",
				    "can_be_siphoned_from": true,
					"inventory_size": 69
				}
			},
			"gold": {
				"minecraft:inventory": {
					"container_type": "minecart_chest",
				    "can_be_siphoned_from": true,
					"inventory_size": 78
				}
			},
			"diamond": {
				"minecraft:inventory": {
					"container_type": "minecart_chest",
				    "can_be_siphoned_from": true,
					"inventory_size": 86
				}
			},
			"netherite": {
				"minecraft:inventory": {
					"container_type": "minecart_chest",
				    "can_be_siphoned_from": true,
					"inventory_size": 136
				}
			},


			"open": {
				"minecraft:entity_sensor": {
					"sensor_range": 0.5,
					"relative_range": false,
					"minimum_count": 1,
					"event_filters": {
						"any_of": [
							{
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									},
									{
										"test": "has_container_open",
										"operator": "!=",
										"subject": "other"
									}
								]
							}
						]
					},
					"event": "close"
				}
			},
			"close": {
				"minecraft:entity_sensor": {
					"sensor_range": 0.5,
					"relative_range": false,
					"minimum_count": 1,
					"event_filters": {
						"any_of": [
							{
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									},
									{
										"test": "has_container_open",
										"subject": "other"
									}
								]
							}
						]
					},
					"event": "open"
				}
			}
		},
		"components": {
			"minecraft:breathable": {
				"breathes_solids": true,
				"breathes_lava": true,
				"generates_bubbles": false
			},
			"minecraft:inventory": {
				"container_type": "minecart_chest",
				"can_be_siphoned_from": true,
				"inventory_size": 200
			},
			"minecraft:damage_sensor": {
				"triggers": {
					"deals_damage": false
				}
			},
			"minecraft:fire_immune": true,
			"minecraft:health": {
				"value": 20,
				"min": 20,
				"max": 20
			},
			"minecraft:collision_box": {
				"height": 0.8,
				"width": 0.4
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},
			"minecraft:physics": {
				"has_collision": false,
				"has_gravity": false
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:entity_sensor": {
				"sensor_range": 0.5,
				"relative_range": false,
				"minimum_count": 1,
				"event_filters": {
					"any_of": [
						{
							"all_of": [
								{
									"test": "is_family",
									"subject": "other",
									"value": "player"
								},
								{
									"test": "has_container_open",
									"subject": "other"
								}
							]
						}
					]
				},
				"event": "open"
			}
		},
		"events": {
			"open": {
				"sequence": [
					{
						"add": {
							"component_groups": [ "open" ]
						},
						"remove": {
							"component_groups": [ "close" ]
						},
						"queue_command": {
							"command": "tag @s add open"
						}
					}
				]
			},
			"close": {
				"remove": {
					"component_groups": [ "open" ]
				},
				"add": {
					"component_groups": [ "close" ]
				},
				"queue_command": {
					"command": "tag @s remove open"
				}
			},


			"leather": {
				"add": {
					"component_groups": [
						"leather"
					]
				}
			},
			"copper": {
				"add": {
					"component_groups": [
						"copper"
					]
				}
			},
			"iron": {
				"add": {
					"component_groups": [
						"iron"
					]
				}
			},
			"gold": {
				"add": {
					"component_groups": [
						"gold"
					]
				}
			},
			"diamond": {
				"add": {
					"component_groups": [
						"diamond"
					]
				}
			},
			"netherite": {
				"add": {
					"component_groups": [
						"netherite"
					]
				}
			}
		}
	}
}