{
	"format_version": "1.8.0",
	"render_controllers": {
		// backpack base 
		"controller.render.backpack_base": {
			"is_hurt_color": {},
			"on_fire_color": {},
			"geometry": "geometry.backpack_base",
			"materials": [ { "*": "Material.default" } ],
			"textures": [ "texture.b_base" ]
		},
		// backpack level
		"controller.render.backpack_level": {
			"is_hurt_color": {},
			"on_fire_color": {},
			"geometry": "geometry.backpack",
			"materials": [ { "*": "Material.default" } ], 
			"textures": [ "Array.level[q.property('bp:is_backpack')]" ],
			"arrays": {
				"textures": {
					"Array.level": [
						"texture.b_leather",
						"texture.b_leather",
						"texture.b_copper",
						"texture.b_iron",
						"texture.b_gold",
						"texture.b_diamond",
						"texture.b_nether"
					]
				}
			}
		},

