    "hover_item_crafting": {
        "type": "button",
        "size": [ "100%", "100%" ],
        "layer": 2,
        "hover_control": "hover",
        "$is_backpack_item|default": false,
        "$is_aditament_item|default": false,
        "bindings": [
            {
                "binding_type": "view",
                "source_control_name": "$layout_item_button",
                "source_property_name": "#toggle_state",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "hover@pause.text_item_selected_backpack": {}
            },
            {
                "image_crafting": {
                    "type": "image",
                    "size": [ "100%", "100%" ],
                    "texture": "$texture_item_slot",
                    "variables": [
                        {
                            "requires": "$is_backpack_item",
                            "$texture_item_slot": "('textures/ui/crafters/backpacks/num_' + $crafting_bp_num)"
                        },
                        {
                            "requires": "$is_aditament_item",
                            "$texture_item_slot": "('textures/ui/crafters/aditaments/num_' + $crafting_bp_num)"
                        }
                    ]
                }
            }
        ]
    },
