  "header_panel_backpack": {
    "type": "panel",
    "layer": 1,
    "size": [ "50%", "27px" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "header_background": {
          "type": "image",
          "layer": 40,
          "texture": "textures/ui/header_bar"
        }
      },
      {
        "text_title": {
					"type": "label",
					"text": "$text_backpack",
          "$text_backpack|default": " ",
					"color": "$pocket_title_text_color",
					"layer": 42,
          "anchor_from": "center",
          "anchor_to": "center"
				}
      }
    ]
  },

  "header_area": {
    "type": "panel",
    "$stext": "$container_title",
    "controls": [
      { "x@common.legacy_pocket_close_button": { "layer": 50 } },
      {
        "inventory_header@pocket_containers.header_panel": {
          "$header_label": "chestScreen.header.player"
        }
      },
      {
        "container_header@pocket_containers.header_panel": {
          "visible": "(not (('%.15s' * $stext) = 'backpackExecute'))",
          "layer": 2,
          "anchor_from": "top_middle",
          "$header_label": "$container_title"
        }
      },
      {
        "title_text_backpack@pocket_containers.header_panel_backpack": {
          "layer": 2,
          "anchor_from": "top_middle",
          "visible": "(('%.15s' * $stext) = 'backpackExecute')"
        }
      }
    ]
  },

  //--------------------
  // Screen Definitions
  //--------------------

  "panel_backpack@pocket_containers.panel": {
    "$etext": "$container_title",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": { "layer": 3 } },
      { "header@header_area": { "layer": 2 } },
      { "bg@background_panel": { "layer": 0 } },
      {
        "inventory@half_screen": {
          "$container_size": 36,
          "$pane_collection": "combined_hotbar_and_inventory_items"
        }
      },
      {
        "container@half_screen": {
          "anchor_from": "top_middle",
          "$pane_collection": "container_items"
        }
      },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "$offset": [ 0, "85%" ]
        }
      },
      { "gamepad_cursor@common.gamepad_cursor_button": {} },
      { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
      { "hold_icon@common.inventory_take_progress_icon_button": {} },
      { "flying_item_renderer@common.flying_item_renderer": {} },
      {
        "function_slots@chest_bp.stots_function": {
          "$offset_var": [-5, 43],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "$size_slot_function_bp_cell": [26, 26],
          "$size_slot_function_bp": [26, 27],
          "$layer_bp_background_functions": -28
        }
      },
      {
        "buttons_bp_aditaments@chest_bp.button_furnace": {
          "$anchor_buttons_adit": "top_middle",
          "layer": 5,
          "offset": [5, 33]
        }
      },
      {
        "black_image_center_buttons": {
          "anchor_from": "center",
          "anchor_to": "center",
          "$index_function_slot1|default": 999,
          "$index_function_slot2|default": 999,
          "$index_function_slot3|default": 999,
          "$index_function_slot4|default": 999,
          "$index_function_slot5|default": 999,
          "$index_function_slot6|default": 999,
          "type": "image",
          "layer": 15,
          "offset": [20, 0],
          "size": [10, "100%"],
          "texture": "textures/ui/TabLeftFront",
          "controls": [
            {
              "stackpanel_liquid_container_evalue_pe": {
                "type": "stack_panel",
                "$offset_var_liquid_text": [ "-10%c", -44 ],
                "$size_liquid_var_count": ["100%", 18],
                "$offset_image_hover_liquid": [-6, 0],
                "$offset_image_hover_liquid_2": [6, 0],
                "layer": 15,
                "size": [ "100%c", "88%" ],
                "orientation": "horizontal",
                "collection_name": "container_items",
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [40, 12],
                "controls": [
                  {
                    "containers_liquid_stackpanel_1@chest_bp.stackpanel_liquid_container_evalue": {
                      "$index_panel_liquid": "$index_function_slot1"
                    }
                  },
                  {
                    "containers_liquid_stackpanel_2@chest_bp.stackpanel_liquid_container_evalue": {
                      "$index_panel_liquid": "$index_function_slot2"
                    }
                  },
                  {
                    "containers_liquid_stackpanel_3@chest_bp.stackpanel_liquid_container_evalue": {
                      "$index_panel_liquid": "$index_function_slot3"
                    }
                  },
                  {
                    "containers_liquid_stackpanel_4@chest_bp.stackpanel_liquid_container_evalue": {
                      "$index_panel_liquid": "$index_function_slot4"
                    }
                  },
                  {
                    "containers_liquid_stackpanel_5@chest_bp.stackpanel_liquid_container_evalue": {
                      "$index_panel_liquid": "$index_function_slot5"
                    }
                  },
                  {
                    "containers_liquid_stackpanel_6@chest_bp.stackpanel_liquid_container_evalue": {
                      "$index_panel_liquid": "$index_function_slot6"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
